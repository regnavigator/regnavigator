# medi-front 환경변수

# ═══════════════════════════════════════════════════════════
# 시나리오 1 — Mock 모드 (Vercel 테스트 배포 권장)
# ═══════════════════════════════════════════════════════════
# backend·DB 없이 public/mocks/*.json 픽스처로 동작. 풀 UI/UX 데모.

# NEXT_PUBLIC_DUMMY_MODE=true
# NEXT_PUBLIC_AUTH_BYPASS=true
# NEXTAUTH_URL=https://<your-app>.vercel.app
# NEXTAUTH_SECRET=<openssl rand -base64 32>
# DATABASE_URL=file:./dev.db          # Prisma generate용 dummy (사용 안 됨)

# ═══════════════════════════════════════════════════════════
# 시나리오 2 — 실제 backend 연결
# ═══════════════════════════════════════════════════════════
# medi-back langgraph 서버가 인터넷에 노출돼야 함 (Render/Railway/Fly 등).

# LangGraph deployment URL — Reports/Suggestions 라우트 동일 base.
NEXT_PUBLIC_DEPLOYMENT_URL=https://your-deployment.example.com

# (폐기 2026-07-14, ADR-0001 Phase 4) — 자체 SSE(POST /chat) 전환으로
# NEXT_PUBLIC_ASSISTANT_ID / NEXT_PUBLIC_LANGSMITH_KEY 불요. 남겨도 무시됨.

# 더미 모드
NEXT_PUBLIC_DUMMY_MODE=false

# NextAuth (매직 링크 / credentials)
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=<openssl rand -base64 32>

# Resend 권장 (또는 SMTP)
EMAIL_FROM=noreply@your-verified-domain.com
RESEND_API_KEY=re_xxxxxxxx
# 대안: EMAIL_SERVER=smtps://user:pass@smtp.resend.com:465

# DB — Postgres (2026-07-15부터 SQLite 은퇴).
#  - 클라우드(Vercel/Supabase/Neon): PgBouncer URL 분리 권장.
#  - 자체호스팅(docker): medi-back의 medi-postgres 인스턴스 내 별도 DB `medi_auth`.
#    → docker 배포는 .env.docker.example 참조. 컷오버 런북: docs/auth_db_postgres_migration.md
DATABASE_URL=postgresql://...?pgbouncer=true
DIRECT_URL=postgresql://...

# ═══════════════════════════════════════════════════════════
# 클로즈 베타 가입 게이트 (2026-07-15 통일)
# ═══════════════════════════════════════════════════════════
# 진실원 = 백엔드 화이트리스트(medi-back BETA_WHITELIST_EMAILS env ∪ DB, admin
# 화면에서 관리). front 가입 3경로(signup-init·매직링크·signIn)가 백엔드
# POST /beta/check 로 조회한다(lib/betaGate.ts). → 명단 관리는 admin UI 에서.
#
# 백엔드 호출용 URL(서버 사이드) — 미설정 시 NEXT_PUBLIC_DEPLOYMENT_URL 사용.
# 내부망 주소가 따로 있으면(예: docker 네트워크) 지정:
# BACKEND_INTERNAL_URL=http://medi-back:8000
#
# 아래는 **폴백 전용**(백엔드 조회 실패 시). 평상시엔 백엔드 명단이 우선.
# BETA_ALLOWED_EMAILS=foo@bar.com,baz@qux.com
# BETA_ALLOWED_DOMAINS=company.com,partner.org

# Admin 화이트리스트 — 매칭되면 session.user.isAdmin=true → UI에 admin 메뉴 노출
# ADMIN_EMAILS=admin@company.com,ops@company.com

# ═══════════════════════════════════════════════════════════
# 점검 모드
# ═══════════════════════════════════════════════════════════
# true 면 앱 영역 전체가 /maintenance 로 리다이렉트 (landing·login·terms·privacy 는 유지).
# MAINTENANCE_MODE=true
# 점검 페이지 안내 문구 override (예상 복구 시각 등)
# NEXT_PUBLIC_MAINTENANCE_MESSAGE=시스템 점검 중입니다. 오늘 06:00에 재개 예정입니다.

# ---- 배포 식별값 (src/lib/site.ts) — NEXT_PUBLIC_* 는 빌드 시 인라인. 비우면 코드 기본값 ----
# NEXT_PUBLIC_APP_URL=https://app.example.com
# NEXT_PUBLIC_SUPPORT_EMAIL=support@example.com       # 로그인·가입 안내의 문의 주소
# NEXT_PUBLIC_MAIL_FROM=noreply@example.com            # 인증 메일 발신 기본값(EMAIL_FROM 이 우선)
# NEXT_PUBLIC_ROOT_ADMIN_EMAIL=admin@example.com       # 백엔드 ROOT_ADMIN_EMAILS 와 맞출 것

# dev 를 다른 호스트(Tailscale 등)로 접속할 때 허용할 origin(콤마) — next.config.ts
# DEV_ALLOWED_ORIGINS=100.x.y.z
