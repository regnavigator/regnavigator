# build context에서 제외 — image 크기·빌드 시간 단축 + secret 유출 방지

# Git/CI
.git
.github
.gitignore

# 의존성·빌드 산출물 (컨테이너 안에서 다시 생성)
node_modules
.next
.swc
out

# 환경변수 (반드시 제외 — docker compose env_file에서 주입)
# 모든 위치의 .env 파일 (prisma/.env 등 sub-path 포함) — `**` 패턴
.env
.env.*
**/.env
**/.env.*
!.env.example

# 로컬 DB·로그
prisma/dev.db*
prisma/data/
*.log
logs/

# IDE / OS
.vscode
.idea
.DS_Store
Thumbs.db

# 테스트·문서 (런타임 불필요)
README.md
*.md
docs/

# 기타
coverage
.nyc_output
.eslintcache
