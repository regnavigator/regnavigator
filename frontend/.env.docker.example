# medi-front — docker compose 운영 env 템플릿
# 사용: cp .env.docker.example .env.docker  →  값 채움  →  chmod 600 .env.docker
#   docker compose --env-file .env.docker up -d
# (배포는 보통 GitHub Actions self-hosted 러너가 /opt/medi-front 에서 자동 수행)

# ── 인증 DB (Postgres) ────────────────────────────────────────────────
# medi-back의 medi-postgres 인스턴스 내 별도 DB `medi_auth`.
# host=postgres 는 medi-net 네트워크의 medi-back postgres 서비스 별칭.
# 비밀번호는 medi-back .env.docker 의 POSTGRES_PASSWORD 와 동일 값.
# ⚠️ 최초 1회 DB 생성 + SQLite 데이터 이관 필요 — docs/auth_db_postgres_migration.md
DATABASE_URL=postgresql://medi:CHANGE_ME@postgres:5432/medi_auth

# ── NextAuth ──────────────────────────────────────────────────────────
NEXTAUTH_URL=https://app.example.com
# ⚠️ medi-back 의 NEXTAUTH_SECRET 과 반드시 동일 값 (JWT 상호검증).
NEXTAUTH_SECRET=CHANGE_ME_openssl_rand_base64_32

# ── 이메일 (매직링크·비밀번호 재설정) ─────────────────────────────────
EMAIL_SERVER=smtps://resend:CHANGE_ME@smtp.resend.com:465
EMAIL_FROM=noreply@example.com
RESEND_API_KEY=re_CHANGE_ME

# ── 클로즈 베타 게이트 (폴백 전용 — 평시엔 백엔드 명단 우선) ───────────
# BETA_ALLOWED_EMAILS=
# BETA_ALLOWED_DOMAINS=

# ── NEXT_PUBLIC_* (build 시 client bundle 에 inline — 값 바뀌면 --no-cache 재빌드) ──
NEXT_PUBLIC_DEPLOYMENT_URL=https://app.example.com
NEXT_PUBLIC_ASSISTANT_ID=
NEXT_PUBLIC_ASSISTANT_ID_DEEP=
NEXT_PUBLIC_LANGSMITH_KEY=
NEXT_PUBLIC_DUMMY_MODE=false
NEXT_PUBLIC_AUTH_BYPASS=false

# 관리자 이메일(콤마 구분) — medi-back ADMIN_EMAILS 와 같은 값. 세션 isAdmin(점검 게이트·admin 메뉴)
ADMIN_EMAILS=

# ---- 배포 식별값 (src/lib/site.ts) — NEXT_PUBLIC_* 는 빌드 시 인라인. 비우면 코드 기본값 ----
# NEXT_PUBLIC_APP_URL=https://app.example.com
# NEXT_PUBLIC_SUPPORT_EMAIL=support@example.com       # 로그인·가입 안내의 문의 주소
# NEXT_PUBLIC_MAIL_FROM=noreply@example.com            # 인증 메일 발신 기본값(EMAIL_FROM 이 우선)
# NEXT_PUBLIC_ROOT_ADMIN_EMAIL=admin@example.com       # 백엔드 ROOT_ADMIN_EMAILS 와 맞출 것
