# ==========================================================================
# .env.docker — 운영(docker compose) 환경변수 템플릿
# 자동 생성: scripts/gen_env_docker_example.py (docker-compose.yml + config.ENV_REGISTRY)
# 손으로 고치지 말 것 — compose 참조나 레지스트리를 바꾸고 재생성하세요.
#
# REQUIRED = compose 기본값 없음 → 반드시 채워야 함(STRICT_CONFIG=1 이면 일부는 부팅 차단).
# 그 외는 값 그대로가 기본값 — 바꿀 때만 주석 해제/수정.
# ==========================================================================

# ── 인증·보안 / 접근 게이트 ────────────────────────────────────
# admin 자동 부여 이메일(콤마)
ADMIN_EMAILS=<채우세요>    # REQUIRED
# 허용 origin CSV(프런트) — CORS 화이트리스트
API_CORS_ORIGINS=<채우세요>    # REQUIRED
# 보고서 라우트 Bearer 토큰(운영)
API_TOKEN=
# 1이면 화이트리스트 비어도 게이트 강제 활성(전면 차단, ADMIN 제외) — 클로즈 베타 가입 차단
BETA_GATE=
# 클로즈 베타 화이트리스트(콤마) — 이메일 또는 @도메인. 미설정=전면 허용, ADMIN_EMAILS 항상 허용
BETA_WHITELIST_EMAILS=
# NextAuth JWT 검증 시크릿
NEXTAUTH_SECRET=<시크릿>    # REQUIRED
# 서류 기입값(reports.filled_values) 저장 암호화 Fernet 키 — 쉼표로 여러 개=회전. 비우면 NEXTAUTH_SECRET 파생 키(2026-09-18)
FILLED_VALUES_ENC_KEY=
# 야간 골든셋 회귀(medi-cron, KST 03:00) — 배포 지문이 직전과 같으면 건너뛰고 이 일수마다 1회는 강제 실행. QREG_ALWAYS=1 이면 매일.
QREG_MAX_AGE_DAYS=7
QREG_ALWAYS=

# ── LLM (모델·폴백·호출 상한) ─────────────────────────────────
# Anthropic 키
ANTHROPIC_API_KEY=<시크릿>    # REQUIRED
# 1차 모델 오류 시 폴백 스펙
LLM_FALLBACK=openai:gpt-4o
# LLM client-side 초당 호출 상한
LLM_MAX_RPS=8
# supervisor 모델
LLM_MODEL=claude-sonnet-4-6
# run당 모델 호출 상한
MAX_MODEL_CALLS_PER_RUN=250
# OpenAI 폴백 키
OPENAI_API_KEY=<시크릿>    # REQUIRED
# 서브에이전트 폴백 모델 스펙
SUBAGENT_FALLBACK=openai:gpt-4o-mini
# 서브에이전트·요약·grounding 모델(기본 haiku)
SUBAGENT_MODEL=claude-haiku-4-5-20251001
# 스레드 제목 생성 모델
TITLE_MODEL=anthropic:claude-haiku-4-5-20251001

# ── 채팅 루프 (fast) ──────────────────────────────────────
# 규제 질의에서 qdrant 검색 뒤 tavily 웹검색 1회 강제(기본 ON). 0=모델 재량(웹 인용 드묾)
CHAT_FORCE_WEB=1
# 1=POST /chat 자체 루프 비활성(404)
CHAT_LOOP_DISABLE=
# 채팅 답변 최대 출력 토큰
CHAT_MAX_TOKENS=4096
# LLM A/B 테스트 — 'specA|specB'(예: anthropic:claude-haiku-4-5-20251001|anthropic:claude-sonnet-5). user 해시로 변형 배정, events(model_ab)에 태깅. 미설정=단일 모델
CHAT_MODEL_AB=
# 1=시스템 프롬프트 캐싱 끔(기본 ON — Haiku는 프리픽스가 임계 미만이면 무효과)
CHAT_PROMPT_CACHE_DISABLE=
CHAT_PROMPT_CACHE_TTL=1h
PROMPT_WARM_INTERVAL_S=2700
# 대화(thread) 보존일 — 마지막 활동 기준, prune_threads 자동 파기(방침 §3)
CHAT_RETENTION_DAYS=90
# 압축 시 원문 유지할 최근 턴 수
CHAT_SUMMARY_KEEP_TURNS=2
# 압축 요약 모델(미설정=SUBAGENT_MODEL→haiku)
CHAT_SUMMARY_MODEL=
# 대화 압축 트리거(추정 토큰, 0=끔)
CHAT_SUMMARY_TRIGGER_TOKENS=24000
# 1=근거 커버리지 LLM 판정(3층, Haiku 1콜) 활성. 0=규칙(0건 재검색·명시 종별)만
COVERAGE_JUDGE_ENABLE=1

# ── 기관 내부 지침 스킬 (IRB/DRB — src/skills/) ─────────────────────
# 번들 경로. 미설정=기능 자체 비활성(카탈로그·도구·강제 전부 미부착)
# SKILL_BUNDLE_DIR=src/skills/medireg_irb_drb
# SKILL_LOCAL_MODEL=1                 # 스킬 턴 온프레미스 라우팅(상용 노출 제거)
# SKILL_LOCAL_BASE_URL=
# SKILL_LOCAL_MAX_TOKENS=8192          # 스킬 턴 로컬 모델 출력 상한(판정 답변은 4096 에서 잘림)
# REPORT_YIELD_HOLD_S=45
# REPORT_YIELD_MAX_S=300
# 노출 화이트리스트(콤마) — 이메일 또는 @도메인. 미설정=전면 허용.
# 단일 기관 번들이므로 운영에선 해당 기관 도메인으로 잠글 것
# SKILL_WHITELIST_EMAILS=@hospital.kr

# ── RAG 검색 API (DGX openlaw-search) ───────────────────
# 1=의료 도메인 필터 끔
MEDICAL_FILTER_DISABLE=1
# 검색 top_k(반환 조문 수). 서버 rerank_pool=25 이내 — GPU 무관, 리랭킹 후 슬라이스
QDRANT_TOP_K=8
# 검색 API X-API-Key
RAG_SEARCH_API_KEY=<시크릿>    # REQUIRED
# 검색 API 베이스 URL(예 http://host:8080)
RAG_SEARCH_API_URL=<채우세요>    # REQUIRED
# 검색 종별 CSV 재정의(미설정=law,admrul,ordin,prec,expc — 법령+판례+해석례)
RAG_SEARCH_TARGET_TYPES=
# 검색 API 타임아웃(리랭커 콜드 대비)
RAG_SEARCH_TIMEOUT_S=20
# 리랭커 웜핑 주기 초(0=끔) — 콜드 검색 방지
SEARCH_KEEPALIVE_S=240
# 동시 /search 호출 상한(백프레셔 — GPU thrash 방지)
SEARCH_MAX_CONCURRENCY=2

# ── 가드레일 (PII·의도, DGX — 미설정 시 폴백) ─────────────────────
# 의도 분류 X-API-Key
INTENT_API_KEY=
# 의도 분류 서비스 URL(미설정=휴리스틱)
INTENT_API_URL=
# 1=규제 의도 검색강제 끔
INTENT_SEARCH_DISABLE=0
# 의도 분류 타임아웃(입구 저지연)
INTENT_TIMEOUT_S=1
# 1=입력 PII 스크럽 게이트 끔
PII_GATE_DISABLE=0
# PII NER X-API-Key
PII_NER_API_KEY=
# PII NER 서비스 URL(미설정=regex-only)
PII_NER_API_URL=
# PII NER 타임아웃(입구 저지연)
PII_NER_TIMEOUT_S=3

# ── openlaw-etl 4 DB (외부, 읽기전용) ───────────────────────
# Mongo DB명
MONGO_DB=openlaw
# Mongo 접속 URI
MONGO_URI=<채우세요>    # REQUIRED
# Neo4j 비밀번호
NEO4J_PASS=<시크릿>    # REQUIRED
# Neo4j bolt URI(법률그래프·별표)
NEO4J_URI=<채우세요>    # REQUIRED
# Neo4j 사용자
NEO4J_USER=neo4j
# openlaw-etl docker network 이름(합류용)
OPENLAW_NETWORK=openlaw-etl_internal
# openlaw PG 호스트(없으면 PG 비활성)
PG_HOST=<채우세요>    # REQUIRED
# PG DB명
PG_NAME=openlaw
# PG 비밀번호
PG_PASS=<시크릿>    # REQUIRED
# PG 포트
PG_PORT=5401
# PG 사용자
PG_USER=<시크릿>    # REQUIRED

# ── 운영 영속 (medi 자체 Postgres·blob) ─────────────────────
# auth DB명(백업 대상)
AUTH_DB=medi_auth
# 보고서 blob 백엔드(local|gcs)
BLOB_BACKEND=local
# local blob 디렉터리
BLOB_LOCAL_DIR=/app/data/blobs
# checkpoint 백엔드(존치 유물)
CHECKPOINT_BACKEND=postgres
# checkpoint 보존일
CHECKPOINT_RETENTION_DAYS=90
# openlaw PG 커넥션풀 상한
PG_POOL_MAX=20
# medi 운영 PG DB명
POSTGRES_DB=medi
# medi 운영 PG 비밀번호 — 강한 값 필수
POSTGRES_PASSWORD=<채우세요>    # REQUIRED
# medi 운영 PG 사용자(compose 내부)
POSTGRES_USER=medi
# reports 백엔드(postgres|sqlite)
REPORTS_BACKEND=postgres

# ── 보고서 (deep) ────────────────────────────────────────
# 보고서 blob(.md 전문) 보존일 — 만료 시 파일 삭제, 메타는 보존
BLOB_RETENTION_DAYS=30
# 완료 이메일 첨부 포맷(docx|md). 변환 불가 시 md 폴백
REPORT_ATTACH_FORMAT=docx
# 보고서 전체 데드라인(로컬 writer 시 상향)
REPORT_DEADLINE_S=1800
# 질의 분해 모델(미설정=SUBAGENT_MODEL)
REPORT_DECOMPOSE_MODEL=
# 보고서 grounding 모델(미설정=haiku)
REPORT_GROUND_MODEL=
# 새벽 갱신/점검 구간 보고서 대기 상한(초) — 잡을 죽이지 않고 pause/resume
REPORT_MAINT_WAIT_MAX_S=2700
# writer(27B) 동시 실행 상한 — 단일 GPU 보호(초과 대기)
REPORT_MAX_CONCURRENCY=1
# 분해 쿼리 상한(하위질문 수)
REPORT_MAX_QUERIES=5
# 보고서 수집 top_k(채팅보다 깊게 — 근거 폭↑, rerank_pool=25 이내)
REPORT_QDRANT_TOP_K=20
# 1=초안→비평→개정 패스(품질↑·지연↑). 0=단발 합성
REPORT_REVISE_ENABLE=1
# 비평(검수) 교차 모델 — 미설정=haiku 교차검수, self=writer 자기검수
# REPORT_CRITIQUE_MODEL=
# 웹(T3) 언급 조문의 T1(법령 원문) 승격 재검색 상한. 0=끔
# REPORT_TIER_UPGRADE_MAX=3
# 보고서 rag 동시 검색 상한 — 채팅 우선 레인(전역 슬롯 중 1개를 채팅 몫으로 보장). 0=끔
REPORT_SEARCH_MAX_CONCURRENCY=1
# 소스 수집 per-source 타임아웃
REPORT_SOURCE_TIMEOUT_S=60
# writer vLLM 인증
REPORT_WRITER_API_KEY=
# writer 로컬 vLLM /v1 URL(미설정=Sonnet)
REPORT_WRITER_BASE_URL=
# writer 최대 출력 토큰(심층 보고서)
REPORT_WRITER_MAX_TOKENS=8000
# writer 모델 id — 비우면 /v1/models 로 서빙 모델 자동 감지(모델 교체 시 env 불일치 사고 방지)
REPORT_WRITER_MODEL=
# writer 요청 타임아웃(로컬 27B 대비)
# writer 도달 프로브 캐시(초) — /load reports.writer_up (보고서만 불가 안내, 2026-09-07)
REPORT_WRITER_PROBE_TTL_S=30
# 별표·서식 뷰어 HTML 캐시(컨테이너 내부 경로, 2026-09-08)
ANNEX_VIEW_CACHE_DIR=/tmp/medi_annex_view
REPORT_WRITER_TIMEOUT_S=900

# ── 이메일 알림 (SMTP) ─────────────────────────────────────
# smtps://user:pass@host:465 (medi-front 와 공유). 있으면 SMTP_* 무시
EMAIL_SERVER=
# 발신자(From). EMAIL_FROM 보다 우선. 표시명 형식 허용 — 받은편지함에 `noreply` 대신 서비스명이 보이게(2026-09-14 운영 결정, 모든 백엔드 메일 공통)
SMTP_FROM=MEDIREG AI <noreply@example.com>
# SMTP 호스트(EMAIL_SERVER 없을 때). 예 smtp.gmail.com
SMTP_HOST=
# SMTP 비밀번호/앱비번
SMTP_PASS=
# SMTP 포트(587 STARTTLS / 465 SSL)
SMTP_PORT=587
# 1=SSL(465), 미설정=STARTTLS(587)
SMTP_SSL=
# SMTP 사용자
SMTP_USER=

# ── 웹검색 (Tavily) ──────────────────────────────────────
# Tavily 웹검색 키
TAVILY_API_KEY=<시크릿>    # REQUIRED
# 웹검색 결과수
TAVILY_MAX_RESULTS=5

# ── 운영 안전장치·관측·한도 ─────────────────────────────────────
# pg_dump 백업 주기(초)
BACKUP_INTERVAL_S=86400
# 백업 보존일
BACKUP_RETENTION_DAYS=14
# 사용자 일일 토큰 한도 기본값 (2026-08-05: 10M→2M. 실측 p95=92만의 2배 여유)
DEFAULT_DAILY_TOKEN_LIMIT=2000000
# 사용자 월간 토큰 한도 기본값 (2026-07-22 상향)
DEFAULT_MONTHLY_TOKEN_LIMIT=1000000000
# 쿼터의 "하루" 경계 타임존(UTC 오프셋 시). 9=KST 자정 리셋, 0=구 동작(UTC)
USAGE_DAY_UTC_OFFSET_HOURS=9
# LangSmith 트레이싱은 **제거되었다**(2026-09-10). compose 가 LANGSMITH_TRACING=false
# 를 고정 주입하므로 여기에 키를 넣어도 트레이싱되지 않는다. 되살리려면 개인정보
# 처리방침 §5(국외이전)에 LangChain, Inc. 를 다시 등재하는 것이 선행되어야 한다.
# 로그 레벨
LOG_LEVEL=INFO
# run당 qdrant 검색 라운드 상한
MAX_QDRANT_CALLS_PER_RUN=4
# run당 tavily 웹검색 상한
MAX_TAVILY_CALLS_PER_RUN=2
# 알림 dedup 쿨다운
OPS_ALERT_DEDUP_S=600
# 장애 알림 Slack webhook
OPS_ALERT_WEBHOOK_URL=
# 1=보존정리 실삭제(0=DRY_RUN)
PRUNE_APPLY=0
# 보존정리 주기(초)
PRUNE_INTERVAL_S=86400
# 1=rate limit 끔(dev)
RATE_LIMIT_DISABLE=0
# IP당 분당 요청 상한
RATE_LIMIT_PER_IP_PER_MIN=60
# 사용자당 시간당 요청 상한
RATE_LIMIT_PER_USER_PER_HOUR=600
# 사용자당 분당 요청 상한
RATE_LIMIT_PER_USER_PER_MIN=30
# /readyz probe 타임아웃
READYZ_PROBE_TIMEOUT_S=4
# 에이전트 재귀 상한(존치 유물)
RECURSION_LIMIT=30
# 1=prod 필수 env 누락 시 부팅 차단(사고 방지)
STRICT_CONFIG=1

# ── cache ─────────────────────────────────────────────
# 검색 결과 캐시 크기
SEARCH_CACHE_SIZE=512
# 검색 캐시 TTL
SEARCH_CACHE_TTL_S=3600

# ---- 배포 식별값 — 비우면 src/config.py ENV_REGISTRY 기본값 ----
# APP_URL=https://app.example.com            # 메일 본문 링크
# SUPPORT_EMAIL=support@example.com          # 사용자 문의 안내 주소
# ROOT_ADMIN_EMAILS=admin@example.com        # 루트 관리자(콤마, 강등 불가) — 프런트 NEXT_PUBLIC_ROOT_ADMIN_EMAIL 과 맞출 것
