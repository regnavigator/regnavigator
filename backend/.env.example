# medi-back 환경변수 — 04_INFRASTRUCTURE.md §2 참조

# === 필수 ===
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
TAVILY_API_KEY=

# === 모델 (03_ARCHITECTURE §2) ===
LLM_MODEL=anthropic:claude-sonnet-4-6
LLM_FALLBACK=openai:gpt-4o
SUBAGENT_MODEL=anthropic:claude-haiku-4-5-20251001
SUBAGENT_FALLBACK=openai:gpt-4o-mini

# === 클로즈 베타 (화이트리스트 가입) ===
# 설정 시 목록 밖 사용자는 유효 JWT 여도 403 (front 가입 우회 불가, 매 요청 검사
# — 리스트에서 빼면 기발급 JWT 도 즉시 차단). ADMIN_EMAILS 는 항상 허용.
# 항목: 이메일 또는 @도메인(그 도메인 전체 허용). 미설정=전면 허용.
# BETA_WHITELIST_EMAILS=doctor1@hospital.kr,ra@medtech.co.kr,@partner.co.kr
# BETA_GATE=1               # 1이면 화이트리스트 비어도 게이트 강제 활성(가입 전면 차단, ADMIN 제외)
# 베타 초대 메일은 **자동 발송이 아니다** — admin 화면에서 한 건씩 버튼으로
# 보낸다(POST /admin/whitelist/{entry}/invite). 발송 이력은 beta_whitelist.invited_at.

# === /chat 루프 (현행 유일 경로 — ADR-0001 컷오버 완료) ===
# 기본값으로 동작 — 필요 시 주석 해제해 조정.
# CHAT_LOOP_DISABLE=1               # POST /chat 자체 루프 비활성(404)
# CHAT_MAX_TOKENS=4096              # 채팅 답변 최대 출력 토큰
# SKILL_LOCAL_MAX_TOKENS=8192       # 스킬 턴 로컬 모델 출력 상한(판정 답변은 4096 에서 잘림)
# DOC_FILL_DISABLE=               # 1이면 서류 초안 턴 대조 기입 끔
# DOC_FILL_MODEL=                 # 서류 기입 모델(미설정=haiku)
# DOC_FILL_BASE_URL=              # 온프레미스 기입 모델(OpenAI 호환). 설정 시 원문 처리 — 성명·연락처 칸을 채팅으로 채울 수 있다
#                                 # 예: http://192.0.2.40:8080/v1  (보고서 writer 와 다른 호스트여야 경합 없음)
# DOC_FILL_TIMEOUT_S=60
# FILLED_VALUES_ENC_KEY=            # 서류 기입값 저장 암호화 Fernet 키(쉼표=회전). 비우면 NEXTAUTH_SECRET 파생
# KORDOC_CLI=                    # kordoc CLI 경로 — 원본 서식(.hwpx) 기입(미설정=PATH 의 kordoc)
# CHAT_AUTO_CONTINUE_MAX=2          # max_tokens 잘림 시 자동 이어쓰기 횟수(0=끔). 초과분은 FE [이어서 작성] 버튼
# CHAT_MODEL_OVERRIDE_ALLOW=1       # 요청 body 의 model 오버라이드 허용(dev/벤치)
# CHAT_SUMMARY_TRIGGER_TOKENS=60000 # 대화 압축 트리거(추정 토큰, 0=끔). 첨부 상한 120,000자 문서가 후속 턴까지 남게(2026-09-14)
# CHAT_SUMMARY_KEEP_TURNS=2         # 압축 시 원문 유지할 최근 턴 수
# CHAT_SUMMARY_MODEL=               # 압축 요약 모델(미설정=SUBAGENT_MODEL→haiku)
# CHAT_PROMPT_CACHE_DISABLE=1       # 시스템 프롬프트 캐싱 끔(기본 ON — Haiku는 프리픽스가
# CHAT_PROMPT_CACHE_TTL=1h          # 프롬프트 캐시 TTL(1h|5m) — 기본 1h(성긴 트래픽 상시 히트)
# PROMPT_WARM_INTERVAL_S=2700       # 프롬프트 캐시 웜핑 주기 초(0=끔) — 1차 콜 콜드 방지
#                                   #   캐시 임계 미만이면 무효과, Sonnet/큰 프롬프트엔 유효)

# === 기관 내부 지침 스킬 (IRB/DRB — src/skills/) ===
# 미설정=기능 자체 비활성(카탈로그·도구·강제 전부 미부착 — 기존 채팅과 동일).
# SKILL_BUNDLE_DIR=src/skills/medireg_irb_drb
# SKILL_LOCAL_MODEL=1                 # 스킬 턴을 온프레미스 vLLM 으로(상용 노출 제거). 전제: tool-calling 플래그
# SKILL_LOCAL_BASE_URL=               # 미설정=REPORT_WRITER_BASE_URL 공유
# REPORT_DYNAMIC_OUTLINE=1            # 본론 목차 동적 설계(서론·결론 고정). 0=고정 5섹션
# REPORT_YIELD_HOLD_S=45              # 대화형 후 보고서 양보 유지(초)
# REPORT_YIELD_MAX_S=300              # 보고서 양보 상한(초)
# SKILL_WHITELIST_EMAILS=@hospital.kr # 이메일/@도메인 콤마. 미설정=전면 허용 —
#                                     # 단일 기관 번들이라 운영에선 기관 도메인으로 잠글 것

# === 모델 호출 복원력 ===
# LLM_FALLBACK 설정 시 chat_loop 이 with_fallbacks 로 자동 전환.
# 아래는 기본값 — 필요 시 주석 해제해 조정.
# RESILIENCE_DISABLE=1            # 재시도·폴백·call cap 일괄 비활성 (디버그)
# MODEL_RETRY_MAX=2               # 일시 API 오류 지수 백오프 재시도 횟수

# === RAG 검색 API (openlaw-etl /search) ===
# 랭킹(dense KURE+BM25+RRF+리랭커+법률종부스팅+조문 GROUP BY)·인용메타·grounding
# 원문을 서버가 전부 담당. medi-back 은 이 계약만 안다(로컬 임베딩/Qdrant 없음).
# 계약: openlaw-etl/search-server/API.md
RAG_SEARCH_API_URL=              # 예: http://192.0.2.10:8080 (Tailscale 내부망)
RAG_SEARCH_API_KEY=              # X-API-Key (openlaw-etl INSTANCE_API_KEY)
RAG_SEARCH_TIMEOUT_S=20          # 리랭커 GPU 콜드 대비
# RAG_SEARCH_TARGET_TYPES=law,admrul,ordin,prec,expc  # 기본값(법령+판례+해석례). 조문만 원하면 뒤 2개 제거
SEARCH_MAX_CONCURRENCY=2         # 동시 /search 상한(백프레셔 — 단일 GPU thrash 방지)
SEARCH_KEEPALIVE_S=240           # 리랭커 웜핑 주기 초(0=끔) — idle 후 콜드 검색 방지
QDRANT_TOP_K=12                  # 검색 top_k(반환 조문 수). 서버 rerank_pool=25 이내 → GPU 무관

# === Guardrail (입력 게이트) ===
# 입력 PII 스크럽 — 주민번호·전화·카드·이메일·IP·차량·여권·사업자·지갑을
# 외부(LLM·Tavily) 전송 전 마스킹(regex 1차).
# PII_GATE_DISABLE=1                     # 게이트 끔(디버그)
# 이름·주소는 NER 이 유일한 방어선이라, 스캔이 전 구간을 못 덮으면 차단한다(기본 1).
# 0 으로 끄면 가용성은 오르지만 미마스킹 PII 가 저장·전송될 수 있다.
PII_GATE_STRICT=1
# NER 2차(이름·주소 등 문맥 PII) — 별도 서비스. 미설정 시 regex-only(안전).
# 계약: docs/guardrail_ner_service.md
# PII_NER_API_URL=                       # 예: http://guardrail-host:8090
# PII_NER_API_KEY=
# PII_NER_TIMEOUT_S=3
# 의도 검색강제 — 규제 질의에 법령검색 강제(답변모델 환각 차단). 기본 ON.
# INTENT_SEARCH_DISABLE=1                 # 검색강제 끔(디버그)
# 의도 분류기(Qwen3.5-0.8B 등) — 미설정 시 인사말 휴리스틱 폴백. 계약: docs/guardrail_intent_service.md
# INTENT_API_URL=                        # 예: http://guardrail-host:8091
# INTENT_API_KEY=
# INTENT_TIMEOUT_S=1

# === 문서 붙여넣기 지원 (2026-08-04) ===
# 채팅 1턴 입력 상한(문자). 모델 컨텍스트(1M)와 무관한 운영 상한 —
# PII NER 왕복·토큰 쿼터·이후 턴 컨텍스트 비용 때문에 둔다. 예전 8,000자는
# 문서를 붙여넣으면 바로 422 라 사용자 리포트가 들어왔다.
CHAT_MAX_INPUT_CHARS=32000
# === 파일 업로드 v1 (2026-08-05) — POST /files/extract + /chat attachments ===
# 원본은 저장하지 않는다(추출 텍스트만 반환·대화 저장 시 PII 마스킹).
# 지원: PDF(텍스트)·DOCX·HWPX·TXT. 구형 HWP/DOC·스캔 PDF 는 안내 거절.
FILE_MAX_UPLOAD_MB=15
# 파일당 추출 상한 — 계획서 50쪽 안팎(≈10만 자)을 통째로(2026-09-14, 종전 30,000).
FILE_MAX_EXTRACT_CHARS=120000
CHAT_MAX_ATTACHMENTS=3
# 본문+첨부 합산 상한 — NER 교체 후 PII 는 병목 아님(150,000자 1.8s 실측).
# 남은 제약은 모델 컨텍스트·턴당 토큰 비용.
CHAT_MAX_TOTAL_INPUT_CHARS=150000
# PII NER 은 512토큰 상한 모델이라 긴 텍스트를 통째로 보내면 뒷부분이 조용히
# 미탐된다 → 겹치는 청크로 나눠 보낸다. 겹침은 경계에 걸친 이름·주소 보호용.
PII_NER_CHUNK_CHARS=600
PII_NER_CHUNK_OVERLAP=100
PII_NER_MAX_PARALLEL=2   # 동시 요청 = 동시 활성화 메모리(8/4 호스트 OOM 후 하향)
# 전체 스캔 벽시계 예산(초). 초과분은 포기하고 진행하되 경고를 남긴다.
# 15→30(2026-09-14): 입력 상한 150,000자에 맞춘 GPU 경합 여유.
PII_NER_TOTAL_BUDGET_S=30
# 의도 분류기(0.8B)에 문서를 통째로 보내면 타임아웃 → 판정 무력화. 앞뒤만 남긴다.
INTENT_MAX_INPUT_CHARS=2000

# === 동작 튜닝 ===
TAVILY_MAX_RESULTS=5
RECURSION_LIMIT=30
# 도구 호출 한도 — 모델이 프롬프트 가드 무시 시 차단
MAX_QDRANT_CALLS_PER_RUN=4
MAX_TAVILY_CALLS_PER_RUN=3

# === 보고서 writer 모델 ===
# deep 보고서 본문 합성. 기본 = LLM_MODEL(Sonnet). 백그라운드(수분~수시간 허용)라
# 지연보다 비용이 중요 → 로컬 vLLM(예 DGX Qwen3.5-27B)로 돌리려면 아래 설정.
# (thinking 모드는 코드가 enable_thinking=false 로 자동 차단.)
# REPORT_WRITER_BASE_URL=http://192.0.2.10:8000/v1
# REPORT_SECTIONED=1            # 섹션 분할 작성(기본) — 0 이면 구 단발 writer(분량 ~6,000자)
# REPORT_SECTION_TARGET_CHARS=4000  # 섹션 1개 목표 글자수(총 분량 ≈ 4.75배)
# REPORT_WRITER_MODEL=            # 미설정 = /v1/models 로 서빙 모델 자동 감지(모델 교체 시 env 불일치 사고 방지). 명시하면 그 값 강제
# REPORT_WRITER_API_KEY=                 # vLLM 무인증이면 아무값
# ANNEX_VIEW_CACHE_DIR=            # 별표·서식 뷰어 HTML 캐시 디렉터리(미설정=임시 폴더)
# REPORT_WRITER_PROBE_TTL_S=30   # writer 도달 프로브 캐시(초) — /load reports.writer_up
# REPORT_WRITER_TIMEOUT_S=900
# ⚠️ 로컬 27B 는 느리므로 보고서 데드라인도 상향 필요:
# REPORT_DEADLINE_S=1800
REPORT_MAX_CONCURRENCY=1         # 동시 보고서(27B) 상한 — 단일 GPU 보호(채팅 우선)
REPORT_QDRANT_TOP_K=20           # 보고서 수집 top_k(채팅 12보다 깊게 — 근거 폭↑, rerank_pool=25 이내)
REPORT_REVISE_ENABLE=1           # 1=초안→비평→개정 패스(품질↑·지연↑). 0=단발 합성
REPORT_REGATHER_ENABLE=1         # 1=검수 지적 표적 재수집 1회(질의≤3·근거≤5). 0=끔
# REPORT_CRITIQUE_MODEL=         # 비평(검수) 교차 모델. 미설정=haiku 교차검수, self=writer 자기검수
# REPORT_TIER_UPGRADE_MAX=3      # 웹(T3) 언급 조문의 T1(법령 원문) 승격 재검색 상한. 0=끔
# REPORT_STALE_AFTER_S=10800     # running run 죽은 판정 임계(초). 실소요 상한보다 커야 오탐 없음
# REPORT_WRITER_TIMEOUT_S=1800   # writer 요청 타임아웃 — 초장기 허용(챗 우선 정책)
# REPORT_WRITER_CTX_ANSWER_CHARS=8000     # writer 맥락 provisional_answer 문자 예산
# REPORT_WRITER_CTX_CITATION_CHARS=20000  # writer 맥락 accumulated_citations 문자 예산 — 무예산이면 긴 스레드에서 컨텍스트 초과 400(2026-08-20 사고)
REPORT_ATTACH_FORMAT=docx        # 완료 이메일 첨부 포맷(docx|md). 변환 불가 시 md 폴백
BLOB_RETENTION_DAYS=30           # 보고서 전문(.md) 보존일. 만료 시 파일만 삭제(메타·인용은 보존)

# === 이메일 알림 (SMTP — 보고서 완료 시 전문 첨부 발송) ===
# 미설정 시 stub(로그만) — dev 무해. Gmail/Resend/SendGrid 등 SMTP 아무거나.
# ① medi-front(NextAuth·Resend)와 같은 값 재사용 — 시크릿 이중관리 방지(권장)
# EMAIL_SERVER=smtps://resend:<RESEND_API_KEY>@smtp.resend.com:465
# ② 또는 개별 지정(아래 SMTP_*). EMAIL_SERVER 가 있으면 무시됨.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587                   # 587=STARTTLS / 465=SSL(SMTP_SSL=1)
# SMTP_USER=                      # 계정
# SMTP_PASS=                      # 앱 비밀번호
# SMTP_FROM=                      # 발신주소(미설정=SMTP_USER)
# SMTP_SSL=                       # 1=SSL(465)

# === 영속 — 보고서 메타 + .md 블롭 + 사용자/이벤트/피드백 (src/persistence) ===
# dev (기본) — 로컬 파일 + SQLite (1개 .db 파일에 모든 테이블)
BLOB_BACKEND=local
BLOB_LOCAL_DIR=./reports_blobs
REPORTS_BACKEND=sqlite
REPORTS_SQLITE_PATH=./medi_reports.db

# production 활성화 (배포 단계):
# BLOB_BACKEND=gcs
# BLOB_GCS_BUCKET=medi-reports
# REPORTS_BACKEND=postgres
# REPORTS_PG_DSN=postgresql://user:pass@host:5432/medi
# pip install medi-back[prod]   (psycopg + GCS + kiwipiepy + langchain-openai)
#   dev 에서 REPORT_WRITER_BASE_URL 만 켤 땐: pip install ".[writer-vllm]"
# DDL: db/migrations/001_init.sql 또는 Repos가 자동 init_schema 호출

# (ADR-0001 Phase 5) 체크포인터 은퇴 — thread 상태는 threads_repo(운영 PG/dev SQLite).

# === API (src/api.py · uvicorn 단일 서버) ===
# API_TOKEN=                # legacy. 비워두면 인증 비활성. NextAuth 도입 후엔 NEXTAUTH_SECRET 사용.
API_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173

# === NextAuth JWT 검증 (S3) ===
# medi-front의 NEXTAUTH_SECRET과 같은 값 — 미설정 시 인증 비활성(dev).
# NEXTAUTH_SECRET=
# 첫 admin 부트스트랩 — 콤마 구분 이메일. 가입 시 자동 is_admin=true.
# ADMIN_EMAILS=admin@example.com
# dev 편의 — 인증 헤더 없이도 이 이메일로 자동 로그인 처리 (NEXTAUTH_SECRET 미설정 시).
# AUTH_DEV_BYPASS_USER=

# === 토큰 한도 (S4) — admin이 사용자별 override 가능 (2026-08-05: 일 10M→2M) ===
DEFAULT_DAILY_TOKEN_LIMIT=2000000
DEFAULT_MONTHLY_TOKEN_LIMIT=1000000000
# 쿼터의 "하루" 경계 타임존(UTC 오프셋 시). 기본 9=KST 자정 리셋.
# 0 이면 구 동작(UTC 자정=KST 오전 9시 리셋 — 사용자가 하루를 어긋나게 본다).
USAGE_DAY_UTC_OFFSET_HOURS=9

# === Observability (S2) ===
# DISABLE_TOKEN_LOGGER=1    # set시 글로벌 token 캡처 비활성
# 토큰 usage 를 못 뽑으면 llm_call 이벤트가 안 박혀 쿼터·비용이 조용히 0 이 된다.
# 누락률 경고 주기(초). 스트리밍 중단 등 정상 사유도 있어 매번 찍지 않는다.
TOKEN_USAGE_MISS_LOG_INTERVAL_S=300

# === 운영 안전장치 — 인스턴스 1개 강제 ===
# 동시성 제어(턴 락·LLM RPS 캡·검색 백프레셔·보고서 큐·예약 공지)가 전부 프로세스
# 로컬이다(CLAUDE.md §7). 2번째 인스턴스가 뜨면 대화 히스토리 손상·429 폭풍·중복
# 공지가 발생하므로 PG 어드바이저리 락으로 부팅에서 차단한다.
#   strict(기본)=충돌 시 부팅 차단 | warn=경고만 | off=검사 안 함
# dev(REPORTS_BACKEND=sqlite)는 자동 skip.
SINGLE_INSTANCE_LOCK=strict
# 배포 시 옛 컨테이너 종료를 기다리는 유예(초).
SINGLE_INSTANCE_WAIT_S=20

LOG_LEVEL=INFO
